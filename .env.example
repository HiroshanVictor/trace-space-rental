# Netlify build environment: only these public values are written to config.js.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
# Legacy public JWTs are also supported using SUPABASE_ANON_KEY instead.

# Server-only notification settings. Set real values in Netlify, never in config.js.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_TO_EMAIL=
# Optional override; automatically enabled when all server email settings are set.
# INQUIRY_NOTIFY_ENDPOINT=/.netlify/functions/notify-inquiry

# Optional staging verification; used only by npm run check:cloud.
# CLOUD_CHECK_ALLOW_WRITES=1
# SUPABASE_TEST_STAFF_EMAIL=
# SUPABASE_TEST_STAFF_PASSWORD=
